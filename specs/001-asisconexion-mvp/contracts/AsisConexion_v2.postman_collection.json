              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"THANKS\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/comments/{{commentId}}/reactions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "comments", "{{commentId}}", "reactions"]
