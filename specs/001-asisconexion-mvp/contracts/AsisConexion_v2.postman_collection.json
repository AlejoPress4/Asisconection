              "host": ["{{baseUrl}}"],
              "path": ["v1", "posts", "{{postId}}", "comments"]
            }
          }
        },
        {
          "name": "3.7 Alternar Reacción en Publicación (Toggle SUPPORT)",
          "request": {
            "method": "POST",
