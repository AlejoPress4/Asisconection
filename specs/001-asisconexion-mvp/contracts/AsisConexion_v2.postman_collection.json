  "item": [
    {
      "name": "01 - AuthSession (Identidad Híbrida y Sesiones)",
      "description": "Autenticación contra el servicio central en Render/Supabase (o modo Mock con `USE_MOCK_EXTERNAL_SERVICES=true`) y sesiones rápidas anónimas.",
      "item": [
        {
          "name": "1.1 Login ADMIN (Guarda adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.device_token) {",
                  "  pm.collectionVariables.set('adminToken', json.device_token);",
                  "}",
                  "if (json && json.user && json.user.id) {",
                  "  pm.collectionVariables.set('adminUserAccountId', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@asisco.org\",\n  \"clave\": \"ClaveAsisco2026\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Autentica al administrador general (`admin@asisco.org` en modo Mock o credenciales reales de Render) y guarda `adminToken`."
          }
        },
        {
          "name": "1.2 Login Usuario Registrado Acudiente (Guarda userToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.device_token) {",
                  "  pm.collectionVariables.set('userToken', json.device_token);",
                  "}",
                  "if (json && json.user && json.user.id) {",
                  "  pm.collectionVariables.set('userAccountId', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"maria@prueba.com\",\n  \"clave\": \"ClaveAsisco2026\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Autentica a un usuario registrado (`maria@prueba.com`), sincroniza su `UserAccount` + `Actor` 1:1 y guarda `userToken`."
          }
        },
        {
          "name": "1.3 Login Voluntario / Futuro Moderador (Guarda moderatorToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.device_token) {",
                  "  pm.collectionVariables.set('moderatorToken', json.device_token);",
                  "}",
                  "if (json && json.user && json.user.id) {",
                  "  pm.collectionVariables.set('moderatorUserAccountId', json.user.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@asisco.org\",\n  \"clave\": \"ClaveAsisco2026\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            },
            "description": "Autentica al segundo usuario registrado (`carlos@asisco.org`) para probar conexiones entre actores y asignación del rol global `MODERATOR`."
          }
        },
        {
          "name": "1.4 Registro de Nuevo Usuario en Render y BD Local",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"laura.acudiente\",\n  \"email\": \"laura.acudiente@prueba.com\",\n  \"clave\": \"ClaveSegura2026\",\n  \"rol\": \"ACUDIENTE\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "registro"]
            },
            "description": "Registra una cuenta nueva en el servicio central (Render/Supabase), crea `UserAccount` + `Actor` en `ASISCONEXION_DB` y devuelve el `device_token`."
          }
        },
        {
          "name": "1.5 Alias Login Sincronizado (/v1/auth/sync-session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"maria@prueba.com\",\n  \"clave\": \"ClaveAsisco2026\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/sync-session",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "sync-session"]
            },
            "description": "Alias compatible con clientes v1 que envían `identifier` o `email`."
          }
        },
        {
          "name": "1.6 Iniciar Sesión Rápida Anónima (Guarda anonToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.device_token) {",
                  "  pm.collectionVariables.set('anonToken', json.device_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nickname\": \"MamáDeMateo\",\n  \"role_tag\": \"ACUDIENTE\",\n  \"accept_consent\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/sessions/anonymous",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "sessions", "anonymous"]
            },
            "description": "Crea una `DeviceSession` rápida sin cuenta registrada (`user_account_id = null`) y guarda `anonToken`."
          }
        }
      ]
    },
    {
      "name": "02 - Actors & Connections (Solo Usuarios Registrados)",
      "description": "Gestión de perfil extendido `Actor` 1:1 y conexiones `ActorConnection` (`PENDING`, `ACCEPTED`, `BLOCKED`). Exclusivo para usuarios registrados.",
      "item": [
        {
          "name": "2.1 Obtener Mi Perfil Actor (Usuario 1 -> Guarda actorId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('actorId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/actors/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "actors", "me"]
            }
          }
        },
        {
          "name": "2.2 Actualizar Mi Perfil Actor (PATCH /v1/actors/me)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"primary_role\": \"ACUDIENTE\",\n  \"first_names\": \"María Fernanda\",\n  \"last_names\": \"Gómez Pérez\",\n  \"avatar_url\": \"https://cdn.asisco.org/avatars/maria.jpg\",\n  \"short_bio\": \"Madre cuidadora y participante activa en talleres pedagógicos.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/actors/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "actors", "me"]
            }
          }
        },
        {
          "name": "2.3 Obtener Perfil Actor del Usuario 2 (Guarda receiverActorId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('receiverActorId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/actors/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "actors", "me"]
            }
          }
        },
        {
          "name": "2.4 Consultar Perfil Público de un Actor por UUID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/actors/{{receiverActorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "actors", "{{receiverActorId}}"]
            }
          }
        },
        {
          "name": "2.5 Enviar Solicitud de Conexión (Guarda connectionId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('connectionId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_actor_id\": \"{{receiverActorId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/connections",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "connections"]
            }
          }
        },
        {
          "name": "2.6 Aceptar Solicitud de Conexión (Receptor -> ACCEPTED)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{moderatorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/connections/{{connectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "connections", "{{connectionId}}"]
            }
          }
        },
        {
          "name": "2.7 Listar Mis Conexiones Paginadas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/connections?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "connections"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "2.8 [Regla v2] Sesión Anónima No Tiene Actor (Esperado 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 403 Forbidden para sesiones anónimas', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anonToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/actors/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "actors", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Social (Foros Públicos, Multimedia, Hilos y Reacciones)",
      "description": "Categorías públicas, publicaciones con múltiples URLs multimedia (`PostMedia`), filtro automático (`ContentFilterService`), hilos de comentarios (`parent_id`) y reacciones en posts y comentarios.",
      "item": [
        {
          "name": "3.1 Listar Categorías Públicas (Guarda categoryId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && Array.isArray(json.data) && json.data.length > 0) {",
                  "  pm.collectionVariables.set('categoryId', json.data[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/categories?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "categories"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
        {
          "name": "3.2 Crear Publicación con media_urls (Nace en PENDING -> Guarda postId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created en estado PENDING', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('postId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"content\": \"Comparto nuestra experiencia con rutinas visuales para apoyar la autonomía en casa.\",\n  \"image_url\": \"https://cdn.asisco.org/posts/rutina-portada.jpg\",\n  \"media_urls\": [\n    \"https://cdn.asisco.org/posts/rutina-paso-1.jpg\",\n    \"https://cdn.asisco.org/posts/rutina-paso-2.jpg\"\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/posts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "posts"]
            }
          }
        },
        {
          "name": "3.3 [Filtro Automático] Crear Publicación con Enlace Externo (REJECTED AUTO_FILTER)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 pero marcado como REJECTED AUTO_FILTER', function () {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.status).to.eql('REJECTED');",
                  "  pm.expect(json.rejection_reason).to.eql('AUTO_FILTER');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anonToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"content\": \"Visiten este enlace externo no autorizado https://sitio-spam-externo.com para ganar premios\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/posts",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "posts"]
            }
          }
        },
        {
          "name": "3.4 Listar Publicaciones Aprobadas en Muro Público",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/posts?page=1&limit=20&categoryId={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "posts"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "categoryId",
                  "value": "{{categoryId}}"
                }
              ]
            },
            "description": "Devuelve únicamente publicaciones con `status = 'APPROVED'`. (Ejecuta primero el paso 4.4 para aprobar `{{postId}}` y verla en el muro)."
          }
        },
        {
          "name": "3.5 Crear Comentario Raíz sobre Publicación Aprobada (Guarda commentId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('commentId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{anonToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"¡Muchas gracias por compartir estas rutinas visuales, nos ayudan muchísimo!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/posts/{{postId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "posts", "{{postId}}", "comments"]
            },
            "description": "Nota: Requiere que la publicación `{{postId}}` haya sido aprobada previamente en el paso 4.4."
          }
        },
        {
          "name": "3.6 Crear Respuesta en Hilo (parent_id -> Guarda replyCommentId)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) {",
                  "  pm.collectionVariables.set('replyCommentId', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"¡Con mucho gusto! En el próximo taller llevaremos las plantillas impresas.\",\n  \"parent_id\": \"{{commentId}}\"\n}"
            },
